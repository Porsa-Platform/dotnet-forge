<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotnetForge.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/**/*.*">
      <LogicalName>DotnetForge.Asset|%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Include="Assets/**/*.*" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets" />
  </ItemGroup>
</Project>
